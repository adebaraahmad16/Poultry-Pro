# PoultryPro Frontend Environment Configuration Example
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api

# Production: set this on the FRONTEND Vercel project, using the actual backend domain:
# VITE_API_BASE_URL=https://<your-backend-project>.vercel.app/api

# Vercel: set VITE_API_BASE_URL in Project Settings > Environment Variables
# for Production (and Preview if used), then redeploy. /api is appended if omitted.
# Use the real HTTPS backend URL. localhost is only for local development.
# No backend secrets belong in VITE_* variables.
