PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=poultrypro_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

FRONTEND_URL=http://localhost:5173

# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret

# Admin credentials (local development)
ADMIN_EMAIL=admin@poultrypro.ng
# Generate bcrypt hash: node -e "import('bcryptjs').then(m=>m.default.hash('yourpassword',12).then(console.log))"
ADMIN_PASSWORD_HASH=

# Optional: payment checkout (not required for local development)
# PAYSTACK_SECRET_KEY=
