# Local development defaults. Render uses the private TCP bridge below.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=poultrypro_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false
# Set DB_SSL=true for a provider requiring TLS. For a custom CA, also set
# DB_SSL_CA to its PEM certificate (literal \n escapes are supported).

# Render supplies PORT automatically.
PORT=5000
FRONTEND_URL=https://poultry-pro-pi.vercel.app
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Optional: payment checkout requires the existing backend-only secret.
PAYSTACK_SECRET_KEY=

# Render + existing XAMPP: use a password-protected, non-root MySQL account.
# DB_HOST=127.0.0.1
# DB_PORT=13306
# DB_USER=poultrypro_app
# DB_PASSWORD=<set securely in Render>
# DB_NAME=<existing XAMPP database name>
# DB_SSL=false
# TS_AUTHKEY=<tagged reusable ephemeral key, set only in Render>
# TS_DB_HOST=<Windows Tailscale 100.x address>
# TS_DB_PORT=13306
# TS_VERSION=1.104.1
# DB_SSL=false is valid here because Tailscale encrypts the remote TCP hop.
